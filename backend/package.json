{
  "name": "smart-college-complaint-portal-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Smart College Complaint Portal",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:check": "tsx src/scripts/testConnection.ts",
    "test:attachments": "tsx src/scripts/testAttachments.ts",
    "test:rls": "tsx src/scripts/verifyRlsMigration.ts",
    "test:auth": "tsx src/scripts/testAuth.ts",
    "test:complaints": "tsx src/scripts/testComplaints.ts",
