# ==============================================================================
# Smart College Complaint Portal - Frontend Environment Configuration
# ==============================================================================

# Backend REST API Base URL
# Default local development: http://localhost:5000/api
# Production deployment: https://your-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Supabase Client Configuration
# Safe for browser usage - contains only public publishable key
# NEVER place SUPABASE_SECRET_KEY, service_role key, or database passwords here!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
